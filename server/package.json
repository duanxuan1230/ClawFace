{
  "name": "clawface-mcp",
  "version": "2.0.0",
  "description": "ClawFace — WebSocket daemon + MCP Server for the Android desktop pet",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clawface-mcp": "./dist/index.js",
    "clawface-daemon": "./dist/daemon.js",
    "clawface-cli": "./bin/clawface-cli.ts"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/daemon.js",
    "start:mcp": "node dist/index.js",
    "dev": "tsx src/daemon.ts",
    "dev:mcp": "tsx src/index.ts",
    "cli": "tsx bin/clawface-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "playwright-core": "^1.60.0",
    "ws": "^8.20.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
