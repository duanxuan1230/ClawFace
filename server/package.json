{
  "name": "clawface-mcp",
  "version": "1.0.0",
  "description": "MCP Server for ClawFace — control the Android desktop pet's facial expressions via UDP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clawface-mcp": "./dist/index.js",
    "clawface-cli": "./bin/clawface-cli.ts"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx bin/clawface-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
