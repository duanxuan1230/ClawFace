<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Background decoration: pink blob top-left -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_blob_pink"
        android:layout_gravity="start|top"
        android:translationX="-80dp"
        android:translationY="-40dp"
        android:alpha="0.6" />

    <!-- Background decoration: blue blob bottom-right -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_blob_blue"
        android:layout_gravity="end|bottom"
        android:translationX="80dp"
        android:translationY="40dp"
        android:alpha="0.6" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ClawFace"
            android:textColor="@color/glass_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Permission warning -->
        <TextView
            android:id="@+id/tvPermissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_overlay_required"
            android:textColor="#FFAA00"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_grant_permission"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Tab Switcher: EMOTIONS / USAGE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabEmotions"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="EMOTIONS"
                style="@style/Widget.ClawFace.Button.Glass"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabUsage"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="USAGE"
                style="@style/Widget.ClawFace.Button.Glass"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Tab 1: EMOTIONS -->
        <LinearLayout
            android:id="@+id/layoutTabEmotions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Control Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_start"
                    style="@style/Widget.ClawFace.Button.Glass"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_stop"
                    style="@style/Widget.ClawFace.Button.Glass"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emotions Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmotions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMOTIONS"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp" />

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNeutral"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Neutral"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoy"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Joy"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnxiety"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Anxiety"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnvy"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Envy"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmbarrassment"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Embarr"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnnui"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Ennui"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisgust"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Disgust"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFear"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Fear"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnger"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Anger"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSadness"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Sadness"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MODE"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeActive"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Active"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeStandby"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Standby"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeThinking"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Thinking"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeOffline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Offline"
                        style="@style/Widget.ClawFace.Button.Glass" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="THEME"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemePastel"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Pastel"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeMint"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Mint"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeSunset"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Sunset"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLilac"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Lilac"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeSky"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Sky"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Parameters Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PARAMETERS"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp" />

                <include layout="@layout/slider_item" android:id="@+id/sliderEyeScaleY" />
                <include layout="@layout/slider_item" android:id="@+id/sliderEyeTilt" />
                <include layout="@layout/slider_item" android:id="@+id/sliderEyeSquint" />
                <include layout="@layout/slider_item" android:id="@+id/sliderPupilOffsetX" />
                <include layout="@layout/slider_item" android:id="@+id/sliderMouthCurve" />
                <include layout="@layout/slider_item" android:id="@+id/sliderMouthWidth" />
                <include layout="@layout/slider_item" android:id="@+id/sliderMouthOpen" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Tab 2: USAGE -->
        <LinearLayout
            android:id="@+id/layoutTabUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Quota Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/glass_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="USAGE 配额"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuotaRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="刷新"
                        style="@style/Widget.ClawFace.Button.Glass"
                        android:textSize="11sp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchQuota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 模型连接下拉框 -->
                <Spinner
                    android:id="@+id/spinnerProvider"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/glass_button_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="12dp" />

                <!-- 单组配额展示（Claude / Codex） -->
                <LinearLayout
                    android:id="@+id/layoutQuotaSingle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 5h 行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:text="5h"
                            android:textColor="@color/glass_text_secondary"
                            android:textSize="12sp" />

                        <ProgressBar
                            android:id="@+id/progressQuota5h"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_progress" />

                        <TextView
                            android:id="@+id/tvQuota5hPct"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:gravity="end"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuota5hReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/glass_text_tertiary"
                        android:textSize="10sp"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 7d 行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:text="7d"
                            android:textColor="@color/glass_text_secondary"
                            android:textSize="12sp" />

                        <ProgressBar
                            android:id="@+id/progressQuota7d"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_progress" />

                        <TextView
                            android:id="@+id/tvQuota7dPct"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:gravity="end"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuota7dReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/glass_text_tertiary"
                        android:textSize="10sp"
                        android:layout_marginStart="32dp" />
                </LinearLayout>

                <!-- 多组配额展示（Gemini / AGY） -->
                <LinearLayout
                    android:id="@+id/layoutQuotaGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvQuotaStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开关打开后开始实时获取配额"
                    android:textColor="@color/glass_text_tertiary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Bottom spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
</FrameLayout>
