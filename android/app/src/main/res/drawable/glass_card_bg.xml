<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base semi-transparent white (higher opacity for light theme) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#BFFFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>

    <!-- Inner glow gradient (soft pink tint) -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:centerX="0.3"
                android:centerY="0.3"
                android:startColor="#18FFD2E1"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>

    <!-- Border highlight (brighter for light theme) -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#A6FFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
</layer-list>
